# All HTTP services bind to loopback by default. Keep them there and use SSH tunnels.
SAMEWINDOW_DISPLAY=:99
SAMEWINDOW_SCREEN=1440x900x24
SAMEWINDOW_CHROME_BIN=/usr/bin/google-chrome-stable
SAMEWINDOW_HOME_URL=https://www.google.com/

# Set to 1 only if you deliberately want agent automation on login, verification,
# identity, checkout, and payment pages. The safe default is 0.
SAMEWINDOW_ALLOW_SENSITIVE_AUTOMATION=0
