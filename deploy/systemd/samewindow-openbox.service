[Unit]
Description=SameWindow lightweight window manager
Requires=samewindow-xvfb.service
After=samewindow-xvfb.service

[Service]
Type=simple
User=samewindow
Group=samewindow
EnvironmentFile=-/etc/samewindow.env
Environment=HOME=/var/lib/samewindow
Environment=XDG_RUNTIME_DIR=/var/lib/samewindow/runtime
ExecStart=/opt/samewindow/scripts/run-openbox.sh
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/samewindow
